<?xml version="1.0" encoding="utf-8"?>
<!--
  Reporter on a server, behind IIS.

  IIS signs each person in with Windows Authentication and HttpPlatformHandler starts
  Reporter on a private 127.0.0.1 port, forwarding the caller's Windows token so
  Reporter knows who they are. Settings are then saved per Windows login under
  REPORTER_DATA_ROOT\users\<domain>_<user>\.

  Prerequisites on the server:
    * IIS with the Windows Authentication feature
    * HttpPlatformHandler v1.2 (separate download from Microsoft)
    * Reporter installed with its .venv (setup.ps1), and pywin32 in that .venv
  Site set-up:
    * Application pool: No Managed Code, identity = a service account that can read
      the dealership library and write REPORTER_DATA_ROOT
    * Bind HTTPS with a certificate for the site name
    * Register the Kerberos SPN for the site name and put it in the browsers'
      Intranet zone (Group Policy) so sign-in is silent
  The <authentication> sections are locked at server level by default; unlock them with
    %windir%\system32\inetsrv\appcmd unlock config -section:system.webServer/security/authentication/windowsAuthentication
    %windir%\system32\inetsrv\appcmd unlock config -section:system.webServer/security/authentication/anonymousAuthentication

  Replace every C:\Reporter, D:\ReporterData, site name and admin below.
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
        processPath="C:\Reporter\.venv\Scripts\python.exe"
        arguments="C:\Reporter\reporter_web.py --no-browser --port %HTTP_PLATFORM_PORT%"
        forwardWindowsAuthToken="true"
        startupTimeLimit="60"
        requestTimeout="00:10:00"
        stdoutLogEnabled="true"
        stdoutLogFile="D:\ReporterData\logs\reporter">
      <environmentVariables>
        <environmentVariable name="REPORTER_MODE" value="server" />
        <environmentVariable name="REPORTER_DATA_ROOT" value="D:\ReporterData" />
        <environmentVariable name="REPORTER_PUBLIC_ORIGINS" value="https://reporter.example.local" />
        <!-- Comma-separated DOMAIN\user logins allowed to change shared settings. -->
        <environmentVariable name="REPORTER_ADMINS" value="CORP\brandon.perez" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
