# Reporter -- optional AI layer
#
# Copy this file to ".env" in the same folder and fill in a key. The .env file is
# git-ignored and is never read by anything except ai_config.py, so a key put here
# does not travel with the project, does not appear in user_settings.json, and does
# not turn up in a screenshot of Settings.
#
# Nothing in the reporting pipeline calls a model yet. Filling this in only means the
# connection is ready when it does.
#
# Check what the app can see (prints the key masked, never in full):
#
#     python ai_config.py
#
# Test the key actually works:
#
#     python ai_client.py


# --- required ---------------------------------------------------------------------

# anthropic | openai | azure-openai | custom
# "custom" is anything OpenAI-compatible: an internal gateway, a local server.
REPORTER_AI_PROVIDER=anthropic

# The key itself. Keep it on one line. Never commit this file once it holds a real key.
REPORTER_AI_API_KEY=

# Model name. Leave blank to use the provider default
# (anthropic: claude-sonnet-4-5, openai: gpt-4o-mini).
# For azure-openai this is the deployment name, and it is required.
REPORTER_AI_MODEL=


# --- optional ---------------------------------------------------------------------

# Endpoint override. Required for azure-openai and custom; ignore it otherwise.
#   azure-openai: https://your-resource.openai.azure.com
#   custom:       http://127.0.0.1:11434  (or whatever your gateway is)
#REPORTER_AI_BASE_URL=

# Anthropic API version header, or the azure-openai api-version query parameter.
#REPORTER_AI_API_VERSION=

# Seconds before a call is abandoned. A month-end run should never wait long.
#REPORTER_AI_TIMEOUT=60

# Ceiling on a single response.
#REPORTER_AI_MAX_TOKENS=1024

# Low by default. Insight copy is factual: 0.0-0.3 is the useful range.
#REPORTER_AI_TEMPERATURE=0.2

# Master switch. Normally left alone -- the switch lives in Settings
# ("ai_insights_enabled" in user_settings.json) so it can be toggled without editing
# a file. Uncommenting this overrides the UI, which is handy on a build server.
#REPORTER_AI_ENABLED=false
